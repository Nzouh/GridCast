# Server-side data source: fixtures (default for local dev) or cos (IBM Cloud Object Storage).
GRIDCAST_DATA_SOURCE=fixtures

# Required when GRIDCAST_DATA_SOURCE=cos. Example: https://<bucket-public-host>/<prefix>
COS_BASE_URL=

# Emergency opt-in only. When true, COS failures may serve cached demo fixtures.
GRIDCAST_ENABLE_FIXTURE_FALLBACK=

# Public Mapbox token used by the client-side map.
NEXT_PUBLIC_MAPBOX_TOKEN=
